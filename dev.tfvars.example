# Copy to dev.tfvars (git-ignored) and fill in. Secrets come from env, not this file:
#   export TF_VAR_cloudflare_api_token=...   (CLOUDFLARE_API_TOKEN)
#   export TF_VAR_anthropic_api_key=...      (optional; Anthropic fallback)

cloudflare_zone_id = "REPLACE_WITH_logiforma.dev_ZONE_ID"
deploy_role_arn    = "arn:aws:iam::432417416277:role/REPLACE_WITH_SHARED_DEPLOY_ROLE"

# Overridable defaults (usually leave as-is):
# core_region                 = "ap-south-2"
# ui_host                     = "wheels.logiforma.dev"
# api_host                    = "api-wheels.logiforma.dev"
# auth_host                   = "auth-wheels.logiforma.dev"
# api_lambda_memory_mb        = 1024
# api_provisioned_concurrency = 1
# extract_model               = "global.anthropic.claude-sonnet-4-6"
